#!/usr/bin/env bash
# forge-home — print the absolute path of the F.O.R.G.E. plugin root.
#
# The plugin root is the directory that bundles the harness assets a skill reads
# when the plugin runs from some other product's folder: templates/, docs/ (incl.
# playbooks/ and RISK-TIERS.md), references/, and .claude/workflows/.
#
# Why this exists: plugin skills run with the *product* as the session cwd, not the
# harness. Bare relative paths like `templates/SPEC.md` would resolve against the
# product and miss. Claude Code adds a plugin's bin/ to the Bash tool's PATH while
# the plugin is enabled, so any skill can resolve the harness home with:
#
#     FORGE_HOME="${CLAUDE_PLUGIN_ROOT:-$(forge-home)}"
#     cat "$FORGE_HOME/templates/PROJECT-CLAUDE.md"
#
# It works whether installed from a marketplace (copied into the plugin cache) or
# loaded via `--plugin-dir` in development: it derives the root from its own on-disk
# location (parent of this bin/ dir), so it needs no env var of its own.
set -euo pipefail

src="${BASH_SOURCE[0]:-$0}"
# Resolve symlinks so the parent-dir math is correct even if bin/forge-home is linked.
while [ -h "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd)"
  src="$(readlink "$src")"
  case "$src" in
    /*) ;;            # already absolute
    *) src="$dir/$src" ;;
  esac
done
cd -P "$(dirname "$src")/.." >/dev/null 2>&1 && pwd
