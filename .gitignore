# Legacy local product scratch. Products now live wherever you run `claude` — the
# forge plugin is installed globally, not a workspace you build inside of. Anything
# left under projects/ is local-only and never tracked or shipped with the plugin.
projects/

# Local-only Claude Code state
.claude/settings.local.json
.claude/agent-memory-local/

# Project-specific agent memory stays private — the shared harness ships only
# generic (harness-level) memory. Product internals never leave the local disk.
.claude/agent-memory/**/project_*.md
.claude/agent-memory/forge-quench/defect-patterns-*.md
!.claude/agent-memory/forge-quench/defect-patterns-harness.md

# Private reference playbooks — your reusable product-type knowledge (landing-page
# checklists, layout conventions, ...). Consulted selectively at intake (kickoff/next/
# adopt), never loaded into every agent. Content stays local for now.
references/

node_modules/
.env
.env.*
!.env.example

# Agent/workflow git worktrees (auto-created, ephemeral)
.claude/worktrees/
