{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git worktree *)",
      "Bash(git init *)",
      "Bash(git tag *)",
      "Bash(git checkout -b *)",
      "Bash(git switch -c *)",
      "Bash(git merge *)",
      "Bash(git fetch)", "Bash(git fetch *)",
      "Bash(git pull)", "Bash(git pull *)",
      "Bash(git push origin feature/*)", "Bash(git push -u origin feature/*)",
      "Bash(gh pr create *)", "Bash(gh pr view *)", "Bash(gh pr list *)",
      "Bash(gh pr checks *)", "Bash(gh pr merge *)",
      "Bash(gh auth status)",
      "Bash(git remote)", "Bash(git remote -v)", "Bash(git remote get-url *)",
      "Bash(git switch *)",        // safe branch changes (can't discard files)
      "Bash(git checkout *)",      // convenient but permits `git checkout -- <file>` discards — your call
      "Bash(yarn *)",              // playbook parity with bun/npx
      "Bash(pnpm create *)",
      "Bash(taskkill *)",
      "Bash(curl http://localhost*)",
      "Bash(curl * http://localhost*)",
      "Bash(pnpm install *)",
      "Bash(pnpm add *)",
      "Bash(pnpm run *)",
      "Bash(pnpm test *)",
      "Bash(pnpm exec *)",
      "Bash(pnpm dlx *)",
      "Bash(npm install *)",
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npx *)",
      "Bash(bun *)",
      "Bash(node *)",
      "Bash(python *)",
      "Bash(pip install *)",
      "Bash(uv *)",
      "Bash(go build *)",
      "Bash(go test *)",
      "Bash(go run *)",
      "Bash(cargo build *)",
      "Bash(cargo test *)",
      "Bash(cargo run *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(bash *forge-worktree.sh*)",
      "Bash(bash *forge-pr.sh*)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(vercel *)",
      "Bash(wrangler *)",
      "Bash(fly *)",
      "Bash(railway *)",
      "Bash(eas *)"
    ],
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.development)",
      "Read(./**/.env.production)",
      "Read(./**/.env.staging)",
      "Read(./**/.env.test)",
      "Read(./**/.env.*.local)",
      "Read(./**/secrets/**)",
      "Bash(git push --force*)",
      "Bash(git push -f)",
      "Bash(git push -f *)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ..)",
      "Bash(rm -rf ../*)",
      "Bash(rm -rf .)",
      "Bash(rm -rf ./)"
    ]
  }
}
